<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "") — Task Manager</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 800px; margin: 20px auto; padding: 0 20px; line-height: 1.6; }
        header { background: #007bff; color: white; padding: 15px 20px; border-radius: 8px; margin-bottom: 20px; }
        header h1 { margin: 0; font-size: 1.5em; }
        header .subtitle { margin: 5px 0 0; font-size: 0.95em; opacity: 0.85; }
        nav { margin-top: 10px; display: flex; gap: 15px; }
        nav a { color: rgba(255,255,255,0.85); text-decoration: none; padding: 4px 10px; border-radius: 4px; transition: background 0.2s; }
        nav a:hover { background: rgba(255,255,255,0.2); color: white; }
        nav a.active { background: rgba(255,255,255,0.3); color: white; font-weight: bold; }
        footer { margin-top: 40px; padding: 15px 20px; background: #f5f5f5; border-radius: 8px; text-align: center; color: #666; font-size: 0.9em; }
        section { margin-bottom: 30px; padding: 20px; border: 1px solid #ddd; border-radius: 8px; background: #fafafa; }
        h2 { margin-top: 0; color: #333; }
        .error { color: #d9534f; font-weight: bold; }
        .success { color: #5cb85c; font-weight: bold; }
        .task-done { text-decoration: line-through; color: #888; }
        input, button, textarea { margin: 5px 0; padding: 8px 12px; border: 1px solid #ccc; border-radius: 4px; }
        button { background-color: #007bff; color: white; border: none; cursor: pointer; }
        button:hover { background-color: #0056b3; }
        button.delete-btn { background-color: #dc3545; margin-left: auto; }
        button.delete-btn:hover { background-color: #c82333; }
        ul { list-style-type: none; padding: 0; }
        li { margin: 8px 0; padding: 8px; background: white; border: 1px solid #eee; border-radius: 4px; display: flex; align-items: center; gap: 10px; }
        pre { background: #2d2d2d; color: #f8f8f2; padding: 15px; border-radius: 4px; overflow-x: auto; }
        .empty-message { text-align: center; padding: 20px; color: #888; font-style: italic; }
        .alert { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; padding: 12px; border-radius: 4px; margin: 10px 0; }
        .alert-error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; padding: 12px; border-radius: 4px; margin: 10px 0; }
        form.inline-form { display: inline; }
        .stats-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .stats-table td { padding: 10px; border: 1px solid #ddd; }
        .stats-table td:first-child { font-weight: bold; background: #f5f5f5; width: 40%; }
        .stats-number { font-size: 1.8em; font-weight: bold; color: #007bff; }
        .active-filter { background: #007bff; color: white; padding: 2px 8px; border-radius: 3px; text-decoration: none; }
        .disabled-btn { opacity: 0.5; pointer-events: none; }
    </style>
</head>
<body>
    <header>
        <h1>Task Manager</h1>
        <p class="subtitle">@(ViewData["Description"] ?? "")</p>
        <nav>
            @{
                var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
            }
            <a href="/" class="@(currentPage == "/Index" || string.IsNullOrEmpty(currentPage) ? "active" : "")">Главная</a>
            <a href="/Tasks" class="@(currentPage == "/Tasks" ? "active" : "")">Задачи</a>
            <a href="/Categories" class="@(currentPage.StartsWith("/Categories") ? "active" : "")">Категории</a>
            <a href="/Stats" class="@(currentPage == "/Stats" ? "active" : "")">Статистика</a>
            <a href="/About" class="@(currentPage == "/About" ? "active" : "")">О сервере</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        &copy; @DateTime.Now.Year — Task Manager. Все права защищены.
    </footer>

    @RenderSection("Scripts", required: false)
    @* Задача 2: Подключение скриптов валидации для всех страниц *@
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
