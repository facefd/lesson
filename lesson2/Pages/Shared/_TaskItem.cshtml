@model TaskItem
@using Microsoft.AspNetCore.Mvc.TagHelpers
<li id="task-@Model.Id" class="@(Model.IsDone ? "task-done-item" : "")">
    <div class="checkbox-wrapper">
        <input type="checkbox" @(Model.IsDone ? "checked" : "") onchange="toggleTask(@Model.Id)">
    </div>
    <div style="flex-grow:1;">
        <span class="@(Model.IsDone ? "task-done" : "")">@Model.Title</span>
        @if (Model.Category != null)
        {
            <span class="badge badge-category">@Model.Category.Name</span>
        }
        @if (Model.DueDate.HasValue)
        {
            <span class="badge badge-date">📅 @Model.DueDate.Value.ToString("dd.MM.yyyy")</span>
        }
        <br>
        <span class="task-meta">Создано: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
    </div>
    <a asp-page="/Tasks/Edit" asp-route-id="@Model.Id" class="edit-link" title="Редактировать">✎</a>
    <button class="delete-btn" onclick="deleteTask(@Model.Id)" title="Удалить">✕</button>
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" class="inline-form">
        <button type="submit" class="delete-btn btn-secondary" style="font-size:0.75em; padding:6px 10px;" title="Удалить">Del</button>
    </form>
</li>
