@page "/Stats"
@model StatsModel
@{
    ViewData["Title"] = "Статистика";
    ViewData["Description"] = "Обзор задач и категорий";
    var msg = TempData.Peek("Message");
}

<section>
    <h2>Статистика задач</h2>

    @if (msg != null)
    {
        <div class="alert">@msg</div>
    }

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-number">@Model.TotalCount</div>
            <div class="stat-label">Всего задач</div>
        </div>
        <div class="stat-card done">
            <div class="stat-number">@Model.DoneCount</div>
            <div class="stat-label">Выполнено</div>
        </div>
        <div class="stat-card undone">
            <div class="stat-number">@Model.UndoneCount</div>
            <div class="stat-label">Не выполнено</div>
        </div>
    </div>

    <h3>Задачи по категориям</h3>
    <table>
        <thead>
            <tr>
                <th>Категория</th>
                <th>Всего</th>
                <th>Выполнено</th>
                <th>Не выполнено</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stat in Model.ByCategory)
            {
                <tr>
                    <td><strong>@stat.CategoryName</strong></td>
                    <td><span class="badge badge-category">@stat.Count</span></td>
                    <td><span class="badge badge-success">@stat.DoneCount</span></td>
                    <td><span class="badge badge-danger">@stat.UndoneCount</span></td>
                </tr>
            }
        </tbody>
    </table>

    <form method="post" style="margin-top: 20px;">
        <button type="submit">Обновить статистику</button>
    </form>
</section>
