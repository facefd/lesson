@page "/About"
@model AboutModel
@{
    ViewData["Title"] = "О сервере";
    ViewData["Description"] = "Информация о сервере";
}

<section>
    <h2>О сервере</h2>

    <table>
        <tr>
            <td style="width: 40%; font-weight: 600;">Имя сервера</td>
            <td>@Model.ServerName</td>
        </tr>
        <tr>
            <td style="font-weight: 600;">Версия</td>
            <td><span class="badge badge-category">@Model.Version</span></td>
        </tr>
        <tr>
            <td style="font-weight: 600;">Время запуска</td>
            <td>@Model.StartTime</td>
        </tr>
        <tr>
            <td style="font-weight: 600;">Текущее время</td>
            <td>@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</td>
        </tr>
    </table>

    <p style="margin-top: 20px; color: var(--text-secondary); font-size: 0.9em;">
        Информация отрендерена на сервере без AJAX-запросов.
    </p>
</section>
