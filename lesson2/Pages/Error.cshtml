@page "/Error"

<section style="text-align: center; padding: 60px 20px;">
    <div style="font-size: 4em; margin-bottom: 16px;">⚠️</div>
    <h1 style="color: var(--danger); font-size: 2.5em; margin-bottom: 12px;">500</h1>
    <h2 style="margin-bottom: 16px;">Что-то пошло не так</h2>
    <p style="color: var(--text-secondary); margin-bottom: 28px; max-width: 400px; margin-left: auto; margin-right: auto;">
        Произошла непредвиденная ошибка. Пожалуйста, попробуйте позже.
    </p>
    <a href="/" class="btn">На главную</a>
</section>
