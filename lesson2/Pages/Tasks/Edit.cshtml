@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Редактирование задачи";
    ViewData["Description"] = "Изменение задачи";
}

<section>
    <h2>Редактирование задачи #@RouteData.Values["id"]</h2>

    <div asp-validation-summary="All" class="validation-summary-errors">
        @if (TempData.Peek("Error") != null)
        {
            <div class="alert-error">@TempData.Peek("Error")</div>
        }
    </div>

    <form method="post">
        <input type="hidden" asp-for="Task.Id" />

        <div class="form-group">
            <label asp-for="Task.Title">Название задачи</label>
            <input asp-for="Task.Title" />
            <span asp-validation-for="Task.Title"></span>
        </div>

        <div class="form-group">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input asp-for="Task.IsDone" type="checkbox" style="width: 18px; height: 18px; accent-color: var(--primary);" />
                Выполнено
            </label>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Task.CategoryId">Категория</label>
                <select asp-for="Task.CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                    <option value="">Без категории</option>
                </select>
                <span asp-validation-for="Task.CategoryId"></span>
            </div>

            <div class="form-group">
                <label asp-for="Task.DueDate">Дедлайн</label>
                <input asp-for="Task.DueDate" type="date" />
                <span asp-validation-for="Task.DueDate"></span>
            </div>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 24px;">
            <button type="submit">Сохранить</button>
            <a href="/Tasks?categoryId=@(Model.FilteredCategoryId ?? (int?)null)&sortBy=@Model.SortBy&page=@Model.Page" 
               class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</section>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
<script>
    document.querySelector('form').addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = document.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.textContent = 'Сохранение...';
        
        try {
            const formData = new FormData(this);
            const body = { 
                title: formData.get('Task.Title'), 
                categoryId: formData.get('Task.CategoryId') ? parseInt(formData.get('Task.CategoryId')) : null, 
                isDone: formData.get('Task.IsDone') === 'true', 
                dueDate: formData.get('Task.DueDate') 
            };
            
            const response = await fetch(`/api/tasks/${formData.get('Task.Id')}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'X-Api-Key': 'lesson2-secret' },
                body: JSON.stringify(body)
            });
            
            if (!response.ok) {
                const data = await response.json();
                alert(data.error?.message || 'Ошибка при сохранении');
                return;
            }
            
            window.location.href = `/Tasks?categoryId=${encodeURIComponent(@Model.FilteredCategoryId)}&sortBy=@Model.SortBy&page=@Model.Page`;
        } finally {
            btn.disabled = false;
            btn.textContent = 'Сохранить';
        }
    });
</script>
}
