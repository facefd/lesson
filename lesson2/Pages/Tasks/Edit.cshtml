@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Редактирование задачи";
    ViewData["Description"] = "Изменение названия, статуса, категории и дедлайна";
}

<section>
    <h2>Редактирование задачи #@RouteData.Values["id"]</h2>

    <div asp-validation-summary="All" class="validation-summary-errors">
        @if (TempData.Peek("Error") != null)
        {
            <div class="alert-error">@TempData.Peek("Error")</div>
        }
    </div>

    <form method="post">
        <input type="hidden" asp-for="Task.Id" />

        <div style="margin-bottom: 15px;">
            <label asp-for="Task.Title" style="font-weight: bold; display: block; margin-bottom: 5px;">Название задачи</label>
            <input asp-for="Task.Title" style="width: 100%; padding: 8px;" />
            <span asp-validation-for="Task.Title"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label style="font-weight: bold; display: flex; align-items: center; gap: 8px;">
                <input asp-for="Task.IsDone" type="checkbox" />
                Выполнено
            </label>
            <span asp-validation-for="Task.IsDone"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label asp-for="Task.CategoryId" style="font-weight: bold; display: block; margin-bottom: 5px;">Категория</label>
            <select asp-for="Task.CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                <option value="">— Без категории —</option>
            </select>
            <span asp-validation-for="Task.CategoryId"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label asp-for="Task.DueDate" style="font-weight: bold; display: block; margin-bottom: 5px;">Дедлайн</label>
            <input asp-for="Task.DueDate" type="date" style="width: 100%; padding: 8px;" />
            <span asp-validation-for="Task.DueDate"></span>
        </div>

        <div style="margin-top: 20px; display: flex; gap: 10px;">
            <button type="submit">Сохранить</button>
            <a href="/Tasks?categoryId=@(Model.FilteredCategoryId ?? (int?)null)&sortBy=@Model.SortBy&page=@Model.Page" 
               style="padding: 10px 20px; display: inline-block; background: #6c757d; color: white; text-decoration: none; border-radius: 4px;">Отмена</a>
        </div>
    </form>
</section>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
<script>
    // Задача 9: Индикатор загрузки для кнопки сохранения
    document.querySelector('form').addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = document.querySelector('button[type="submit"]');
        btn.disabled = true;
        btn.textContent = 'Сохранение...';
        
        try {
            const formData = new FormData(this);
            const title = formData.get('Task.Title');
            const categoryId = formData.get('Task.CategoryId');
            const isDone = formData.get('Task.IsDone') === 'true';
            const dueDate = formData.get('Task.DueDate');

            const body = { title, categoryId: categoryId ? parseInt(categoryId) : null, isDone, dueDate };
            
            const response = await fetch(`/api/tasks/${formData.get('Task.Id')}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'X-Api-Key': 'lesson2-secret' },
                body: JSON.stringify(body)
            });
            
            if (!response.ok) {
                const data = await response.json();
                alert(data.error?.message || 'Ошибка при сохранении');
                return;
            }
            
            window.location.href = `/Tasks?categoryId=${encodeURIComponent(@Model.FilteredCategoryId)}&sortBy=@Model.SortBy&page=@Model.Page`;
        } finally {
            btn.disabled = false;
            btn.textContent = 'Сохранить';
        }
    });
</script>
}