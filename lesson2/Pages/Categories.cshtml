@page
@model CategoriesModel
@{
    ViewData["Title"] = "Категории";
    ViewData["Description"] = "Управление категориями задач";
}

<section>
    <h2>Список категорий</h2>
    
    @if (TempData.Peek("Message") != null)
    {
        <div class="alert">@TempData.Peek("Message")</div>
    }
    @if (TempData.Peek("Error") != null)
    {
        <div class="alert-error">@TempData.Peek("Error")</div>
    }

    <h3>Добавить новую категорию</h3>
    <form method="post" style="margin-bottom: 20px;">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        
        <input asp-for="NewCategory.Name" placeholder="Название категории" />
        <span asp-validation-for="NewCategory.Name" class="text-danger"></span>
        <button type="submit">Добавить</button>
    </form>

    <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
        <thead style="background: #f5f5f5;">
            <tr>
                <th style="padding: 10px; border: 1px solid #ddd;">ID</th>
                <th style="padding: 10px; border: 1px solid #ddd;">Название</th>
                <th style="padding: 10px; border: 1px solid #ddd;">Количество задач</th>
                <th style="padding: 10px; border: 1px solid #ddd;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model.Categories)
            {
                <tr>
                    <td>@cat.Id</td>
                    <td>@cat.Name</td>
                    <td>@cat.TaskCount</td>
                    <td>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@cat.Id" style="display:inline;" onsubmit="return confirm('Удалить категорию? Задачи станут без категории.')">
                            <button type="submit" class="delete-btn" style="font-size:0.8em; padding:4px 8px;">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}
