@page
@model CategoriesModel
@{
    ViewData["Title"] = "Категории";
    ViewData["Description"] = "Управление категориями задач";
}

<section>
    <h2>Список категорий</h2>
    
    @if (TempData.Peek("Message") != null)
    {
        <div class="alert">@TempData.Peek("Message")</div>
    }
    @if (TempData.Peek("Error") != null)
    {
        <div class="alert-error">@TempData.Peek("Error")</div>
    }

    <h3>Добавить категорию</h3>
    <form method="post" style="margin-bottom: 24px;">
        <div asp-validation-summary="All" class="validation-summary-errors"></div>
        <div class="form-row">
            <div class="form-group" style="flex: 1;">
                <input asp-for="NewCategory.Name" placeholder="Название категории" />
                <span asp-validation-for="NewCategory.Name"></span>
            </div>
            <div>
                <button type="submit">Добавить</button>
            </div>
        </div>
    </form>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Задач</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model.Categories)
            {
                <tr>
                    <td>@cat.Id</td>
                    <td><strong>@cat.Name</strong></td>
                    <td><span class="badge badge-category">@cat.TaskCount</span></td>
                    <td>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@cat.Id" style="display:inline;" onsubmit="return confirm('Удалить категорию? Задачи останутся без категории.')">
                            <button type="submit" class="delete-btn" style="font-size:0.82em; padding:6px 14px;">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</section>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}
