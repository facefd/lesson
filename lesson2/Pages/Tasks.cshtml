@page "/Tasks"
@model TasksModel
@{
    ViewData["Title"] = "Задачи";
    var msg = TempData.Peek("Message");
    var errMsg = TempData.Peek("Error");
}

<section>
    <h2>Список задач</h2>

    @if (msg != null)
    {
        <div class="alert">@msg</div>
    }
    @if (errMsg != null)
    {
        <div class="alert-error">@errMsg</div>
    }

    <div class="filter-bar">
        <label>Фильтр:</label>
        <select asp-for="@Model.FilteredCategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
            <option value="">Все категории</option>
        </select>
        
        <label>Сортировка:</label>
        <a asp-page="/Tasks" asp-route-categoryid="@Model.FilteredCategoryId" asp-route-sortby="date" 
           class="@(Model.SortBy == "date" ? "active-filter" : "sort-link")">По дате</a>
        <a asp-page="/Tasks" asp-route-categoryid="@Model.FilteredCategoryId" asp-route-sortby="title" 
           class="@(Model.SortBy == "title" ? "active-filter" : "sort-link")">По названию</a>

        <button onclick="applyFilter()">Применить</button>
        <span id="taskCountInfo" style="margin-left: auto; font-size: 0.85em; color: var(--text-secondary); font-weight: 500;"></span>
    </div>

    <div class="filter-bar">
        <input type="hidden" id="currentPage" value="@Model.CurrentPage" />
        <input type="text" id="searchInput" placeholder="Поиск по названию..." style="flex: 1; min-width: 200px;" />
        <button onclick="applySearch()">Найти</button>
    </div>

    <h3>Быстрое добавление</h3>
    <div class="filter-bar">
        <input type="text" id="newTaskTitle" placeholder="Название новой задачи" style="flex: 2; min-width: 200px;">
        <select id="newTaskCategory" style="flex: 1; min-width: 140px;">
            <option value="">Категория</option>
            @foreach (var cat in Model.Categories)
            {
                <option value="@cat.Id">@cat.Name</option>
            }
        </select>
        <button id="addTaskBtn" onclick="addTask()">Добавить</button>
        <span id="ajaxTaskError" style="color: var(--danger); font-size: 0.85em;"></span>
    </div>

    <details style="margin-bottom: 20px;">
        <summary style="cursor: pointer; font-size: 0.9em; color: var(--text-secondary); font-weight: 500; padding: 8px 0;">Классическая форма (без JavaScript)</summary>
        <form method="post" style="margin-top: 12px; padding: 20px; background: #f8fafc; border-radius: var(--radius-sm); border: 1px solid var(--border);">
            <div asp-validation-summary="All" class="validation-summary-errors"></div>
            
            <div class="form-row">
                <div class="form-group" style="flex: 2;">
                    <label asp-for="NewTask.Title">Название</label>
                    <input asp-for="NewTask.Title" placeholder="От 3 до 100 символов" />
                    <span asp-validation-for="NewTask.Title"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NewTask.CategoryId">Категория</label>
                    <select asp-for="NewTask.CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                        <option value="">Без категории</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="NewTask.DueDate">Дедлайн</label>
                    <input asp-for="NewTask.DueDate" type="date" />
                </div>
            </div>
            <button type="submit">Добавить задачу</button>
        </form>
    </details>

    @if (Model.TotalPages > 1)
    {
        <nav class="pagination">
            <span style="margin-right: 8px; font-size: 0.85em; color: var(--text-secondary);">
                @Model.CurrentPage из @Model.TotalPages
            </span>
            
            <a asp-page="/Tasks" 
               asp-route-categoryid="@Model.FilteredCategoryId" 
               asp-route-sortby="@Model.SortBy"
               asp-route-page="@(Model.CurrentPage - 1)"
               class="@(Model.CurrentPage == 1 ? "disabled" : "")">← Назад</a>

            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.CurrentPage)
                {
                    <span class="active-page">@i</span>
                }
                else
                {
                    <a asp-page="/Tasks" 
                       asp-route-categoryid="@Model.FilteredCategoryId" 
                       asp-route-sortby="@Model.SortBy"
                       asp-route-page="@i">@i</a>
                }
            }

            <a asp-page="/Tasks" 
               asp-route-categoryid="@Model.FilteredCategoryId" 
               asp-route-sortby="@Model.SortBy"
               asp-route-page="@(Model.CurrentPage + 1)"
               class="@(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">Далее →</a>
        </nav>
    }

    <ul id="taskList" style="margin-top: 16px;">
        @foreach (var task in Model.PaginatedTasks)
        {
            <partial name="_TaskItem" model="task" />
        }
    </ul>
    @if (!Model.PaginatedTasks.Any())
    {
        <div id="emptyMessage" class="empty-message">Задач пока нет, добавьте первую!</div>
    }
</section>

@section Scripts {
<script>
    let abortController = null;
    
    async function apiRequest(url, options = {}) {
        if (abortController) abortController.abort();
        abortController = new AbortController();
        const signal = abortController.signal;

        try {
            const response = await fetch(url, { ...options, signal });
            const data = await response.json().catch(() => null);
            if (!response.ok) {
                const error = data?.error || { message: "Неизвестная ошибка" };
                throw new Error(error.message);
            }
            return data;
        } catch (err) {
            if (err.name === "AbortError") return null;
            showErrorToast(err.message);
            throw err;
        }
    }

    function showErrorToast(message) {
        const toast = document.createElement('div');
        toast.textContent = message;
        toast.style.cssText = `
            position: fixed; bottom: 24px; right: 24px;
            background: #ef4444; color: white; padding: 14px 22px;
            border-radius: 10px; z-index: 1000; font-size: 0.9em;
            box-shadow: 0 8px 24px rgba(239,68,68,0.3); font-family: Inter, sans-serif;
        `;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3500);
    }

    async function withLoading(button, callback) {
        button.disabled = true;
        button.style.opacity = '0.6';
        const originalText = button.textContent;
        button.textContent = '...';
        try {
            await callback();
        } finally {
            button.disabled = false;
            button.style.opacity = '1';
            button.textContent = originalText;
        }
    }

    async function loadTasks() {
        const categoryId = document.querySelector('[asp-for="FilteredCategoryId"]').value || '';
        const sortBy = document.querySelector('.active-filter')?.textContent.trim() || 'date';
        const page = document.getElementById('currentPage').value;
        const search = document.getElementById('searchInput').value;
        
        const params = new URLSearchParams({ categoryId, sortBy, page, pageSize: '5' });
        if (search) params.append('search', search);
        
        try {
            const response = await apiRequest(`/api/tasks?${params}`);
            const list = document.getElementById('taskList');
            list.innerHTML = '';
            const emptyMsg = document.getElementById('emptyMessage');
            
            if (response.items.length === 0) {
                if (!emptyMsg) {
                    const m = document.createElement('div');
                    m.id = 'emptyMessage'; m.className = 'empty-message';
                    m.textContent = 'Задач пока нет, добавьте первую!';
                    list.parentNode.insertBefore(m, list);
                } else { emptyMsg.style.display = 'block'; }
            } else {
                if (emptyMsg) emptyMsg.style.display = 'none';
            }
            
            response.items.forEach(task => {
                const li = document.createElement('li');
                li.id = 'task-' + task.id;
                li.className = task.isDone ? 'task-done-item' : '';
                const catBadge = task.categoryName ? 
                    '<span class="badge badge-category">' + task.categoryName + '</span>' : '';
                const dateBadge = task.dueDate ? 
                    '<span class="badge badge-date">📅 ' + task.dueDate.substring(0,10) + '</span>' : '';
                li.innerHTML = '<div class="checkbox-wrapper"><input type="checkbox" ' + (task.isDone ? 'checked' : '') +
                    ' onchange="toggleTask(' + task.id + ')"></div>' +
                    '<div style="flex-grow:1;">' +
                    '<span class="' + (task.isDone ? 'task-done' : '') + '">' + task.title + '</span> ' +
                    catBadge + dateBadge +
                    '<br><span class="task-meta">Создано: ' + task.createdAt.substring(0,10) + '</span></div>' +
                    '<a href="/Tasks/Edit/' + task.id + '" class="edit-link" title="Редактировать">✎</a>' +
                    '<button class="delete-btn" onclick="deleteTask(' + task.id + ')" title="Удалить">✕</button>';
                list.appendChild(li);
            });
            
            document.getElementById('taskCountInfo').textContent = 
                `Всего: ${response.totalCount} | Страниц: ${response.totalPages}`;
        } catch (err) {
            console.error(err);
        }
    }

    async function addTask() {
        const titleInput = document.getElementById('newTaskTitle');
        const btn = document.getElementById('addTaskBtn');
        const errorSpan = document.getElementById('ajaxTaskError');
        
        await withLoading(btn, async () => {
            const errors = validateTaskTitle(titleInput.value);
            if (errors.length > 0) { errorSpan.textContent = errors.join(', '); return; }
            errorSpan.textContent = '';

            const categorySelect = document.getElementById('newTaskCategory');
            const body = { title: titleInput.value.trim(), categoryId: categorySelect.value ? parseInt(categorySelect.value) : null };

            try {
                await apiRequest('/api/tasks', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Api-Key': 'lesson2-secret' },
                    body: JSON.stringify(body)
                });
                titleInput.value = ''; 
                categorySelect.value = '';
                await loadTasks(); 
            } catch (err) {
                errorSpan.textContent = err.message;
            }
        });
    }
    
    async function deleteTask(id) {
        const btn = event.target;
        await withLoading(btn, async () => {
            try {
                await apiRequest(`/api/tasks/${id}`, {
                    method: 'DELETE',
                    headers: { 'X-Api-Key': 'lesson2-secret' }
                });
                await loadTasks();
            } catch (err) {
                showErrorToast(err.message);
            }
        });
    }
    
    async function toggleTask(id) {
        await apiRequest(`/api/tasks/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'X-Api-Key': 'lesson2-secret' },
            body: JSON.stringify({ isDone: true })
        });
        await loadTasks();
    }
    
    function applyFilter() {
        const catSelect = document.querySelector('[asp-for="FilteredCategoryId"]');
        const sortBy = document.querySelector('.active-filter')?.textContent.trim() || 'date';
        const page = document.getElementById('currentPage').value;
        const search = document.getElementById('searchInput').value;
        let url = '/Tasks?categoryId=' + (catSelect.value || '') + '&sortBy=' + sortBy + '&page=' + page;
        if (search) url += '&search=' + encodeURIComponent(search);
        window.location.href = url;
    }

    function applySearch() {
        applyFilter();
    }

    function validateTaskTitle(title) {
        var errors = [];
        if (!title || title.trim().length === 0) errors.push('Название обязательно');
        else if (title.trim().length < 3) errors.push('Минимум 3 символа');
        else if (title.toLowerCase().includes('тест')) errors.push('Не должно содержать "тест"');
        return errors;
    }

    document.addEventListener('DOMContentLoaded', () => { loadTasks(); });
</script>
}
