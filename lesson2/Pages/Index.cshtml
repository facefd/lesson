@page "/"
@{
    ViewData["Title"] = "Главная";
    ViewData["Description"] = "Калькулятор и Echo — тестирование API";
}

@section Scripts {
<script>
    async function getServerInfo() {
        const response = await fetch('/api/server-info');
        const data = await response.json();
        document.getElementById('result').textContent = JSON.stringify(data, null, 2);
    }
    async function getSum() {
        const a = document.getElementById('sumA').value;
        const b = document.getElementById('sumB').value;
        const response = await fetch(`/api/sum?a=${encodeURIComponent(a)}&b=${encodeURIComponent(b)}`);
        const data = await response.json();
        const el = document.getElementById('sumResult');
        if (response.ok) { el.textContent = `Результат: ${data.result}`; el.className = 'badge badge-success'; }
        else { el.textContent = `Ошибка: ${data.error}`; el.className = 'badge badge-danger'; }
    }
    async function getDivide() {
        const a = document.getElementById('divA').value;
        const b = document.getElementById('divB').value;
        const response = await fetch(`/api/divide?a=${encodeURIComponent(a)}&b=${encodeURIComponent(b)}`);
        const data = await response.json();
        const el = document.getElementById('divResult');
        if (response.ok) { el.textContent = `Результат: ${data.result}`; el.className = 'badge badge-success'; }
        else { el.textContent = `Ошибка: ${data.error.message}`; el.className = 'badge badge-danger'; }
    }
    async function postEcho() {
        const text = document.getElementById('echoText').value;
        const response = await fetch('/api/echo', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text: text })
        });
        const data = await response.json();
        document.getElementById('echoResult').textContent = JSON.stringify(data, null, 2);
    }
    window.onload = () => { getServerInfo(); };
</script>
}

<section>
    <h2>Информация о сервере</h2>
    <button onclick="getServerInfo()">Получить</button>
    <pre id="result" style="margin-top: 16px;">Загрузка...</pre>
</section>

<section>
    <h2>Калькулятор суммы</h2>
    <div class="form-row">
        <div class="form-group">
            <input type="number" id="sumA" placeholder="Число A" step="any" />
        </div>
        <div class="form-group">
            <input type="number" id="sumB" placeholder="Число B" step="any" />
        </div>
        <div>
            <button onclick="getSum()">Сложить</button>
        </div>
    </div>
    <p id="sumResult" style="margin-top: 12px;"></p>
</section>

<section>
    <h2>Калькулятор деления</h2>
    <div class="form-row">
        <div class="form-group">
            <input type="number" id="divA" placeholder="Число A" step="any" />
        </div>
        <div class="form-group">
            <input type="number" id="divB" placeholder="Число B" step="any" />
        </div>
        <div>
            <button onclick="getDivide()">Разделить</button>
        </div>
    </div>
    <p id="divResult" style="margin-top: 12px;"></p>
</section>

<section>
    <h2>Echo (POST запрос)</h2>
    <div class="form-group">
        <textarea id="echoText" placeholder="Введите текст для отправки" rows="3"></textarea>
    </div>
    <button onclick="postEcho()">Отправить</button>
    <pre id="echoResult" style="margin-top: 16px;">Результат...</pre>
</section>
